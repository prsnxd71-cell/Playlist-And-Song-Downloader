<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="PL Downloader"
             Language="1033"
             Version="1.0.0.0"
             Manufacturer="PL Downloader"
             UpgradeCode="A1DA32C9-E915-4473-B85F-C62330895182">

        <Package InstallerVersion="301"
                 Compressed="yes"
                 InstallScope="perUser"
                 Platform="x64"
                 Description="PL Downloader Installer"
                 Comments="Downloads playlists from Spotify and YouTube as MP3 ZIP archives." />

        <MajorUpgrade DowngradeErrorMessage="A newer version of PL Downloader is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <!-- Directory Structure -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="LocalAppDataFolder">
                <Directory Id="INSTALLFOLDER" Name="PL Downloader" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="PL Downloader" />
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop" />
        </Directory>

        <!-- Components: Main Application -->
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="MainExecutable" Guid="F54D72CD-0758-40D1-BB8D-835FF561747E" Win64="yes">
                <File Id="PLDownloaderEXE"
                      Source="dist\PL_Downloader.exe" />
                <RegistryValue Root="HKCU"
                               Key="Software\PLDownloader"
                               Name="Installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
                <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            </Component>
        </DirectoryRef>

        <!-- Components: Start Menu Shortcut -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="C4731E00-8026-4C49-B501-A91472F4313B" Win64="yes">
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="PL Downloader"
                          Description="Download music playlists to MP3 ZIP"
                          Target="[INSTALLFOLDER]PL_Downloader.exe"
                          WorkingDirectory="INSTALLFOLDER" />
                <RemoveFolder Id="CleanUpStartMenu" On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\PLDownloader\StartMenu"
                               Name="Installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Components: Desktop Shortcut -->
        <DirectoryRef Id="DesktopFolder">
            <Component Id="DesktopShortcutComponent" Guid="542828AD-F46E-4F73-A67B-840B4124EE8B" Win64="yes">
                <Shortcut Id="ApplicationDesktopShortcut"
                          Name="PL Downloader"
                          Description="Download music playlists to MP3 ZIP"
                          Target="[INSTALLFOLDER]PL_Downloader.exe"
                          WorkingDirectory="INSTALLFOLDER" />
                <RegistryValue Root="HKCU"
                               Key="Software\PLDownloader\Desktop"
                               Name="Installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Features -->
        <Feature Id="MainProduct" Title="PL Downloader" Level="1">
            <ComponentRef Id="MainExecutable" />
            <ComponentRef Id="ApplicationShortcut" />
            <ComponentRef Id="DesktopShortcutComponent" />
        </Feature>

        <!-- Standard Wizard UI -->
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
        <UIRef Id="WixUI_InstallDir" />
        <UIRef Id="WixUI_ErrorProgressText" />

    </Product>
</Wix>
