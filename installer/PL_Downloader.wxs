<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="PL Downloader"
             Language="1033"
             Version="1.0.0.0"
             Manufacturer="PL Downloader"
             UpgradeCode="A1DA32C9-E915-4473-B85F-C62330895182">

        <Package InstallerVersion="405"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Platform="x64"
                 Description="Privacy-First Zero-Login Playlist Downloader"
                 Comments="Downloads playlists from Spotify and YouTube as zipped MP3s." />

        <MajorUpgrade DowngradeErrorMessage="A newer version of PL Downloader is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <!-- Directory Structure -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="PL Downloader" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="PL Downloader" />
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop" />
        </Directory>

        <!-- Components: Application Files -->
        <DirectoryRef Id="INSTALLFOLDER">
            <!-- Main Application Executable -->
            <Component Id="MainExecutable" Guid="F54D72CD-0758-40D1-BB8D-835FF561747E" Win64="yes">
                <File Id="PLDownloaderEXE"
                      Source="dist\PL_Downloader.exe"
                      KeyPath="yes"
                      Checksum="yes" />
            </Component>

            <!-- FFmpeg Binary -->
            <Component Id="FFmpegBinary" Guid="90DBA005-852A-424D-99E1-8D31367951BE" Win64="yes">
                <File Id="FFmpegEXE"
                      Source="dist\ffmpeg.exe"
                      KeyPath="yes" />
            </Component>

            <!-- FFprobe Binary -->
            <Component Id="FFprobeBinary" Guid="6B18074F-8D5E-4E24-BD59-7CCFDC25C889" Win64="yes">
                <File Id="FFprobeEXE"
                      Source="dist\ffprobe.exe"
                      KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Components: Start Menu Shortcut -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="C4731E00-8026-4C49-B501-A91472F4313B">
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="PL Downloader"
                          Description="Download music playlists to MP3 ZIP"
                          Target="[INSTALLFOLDER]PL_Downloader.exe"
                          WorkingDirectory="INSTALLFOLDER" />
                <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\PLDownloader\Shortcuts"
                               Name="installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Components: Desktop Shortcut -->
        <DirectoryRef Id="DesktopFolder">
            <Component Id="DesktopShortcutComponent" Guid="542828AD-F46E-4F73-A67B-840B4124EE8B">
                <Shortcut Id="ApplicationDesktopShortcut"
                          Name="PL Downloader"
                          Description="Download music playlists to MP3 ZIP"
                          Target="[INSTALLFOLDER]PL_Downloader.exe"
                          WorkingDirectory="INSTALLFOLDER" />
                <RegistryValue Root="HKCU"
                               Key="Software\PLDownloader\DesktopShortcut"
                               Name="installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Features to Install -->
        <Feature Id="MainProduct" Title="PL Downloader" Level="1">
            <ComponentRef Id="MainExecutable" />
            <ComponentRef Id="FFmpegBinary" />
            <ComponentRef Id="FFprobeBinary" />
            <ComponentRef Id="ApplicationShortcut" />
            <ComponentRef Id="DesktopShortcutComponent" />
        </Feature>

        <!-- Modern UI Wizard -->
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
        <UIRef Id="WixUI_InstallDir" />
        <UIRef Id="WixUI_ErrorProgressText" />

    </Product>
</Wix>
